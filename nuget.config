<?xml version="1.0" encoding="utf-8"?>
<!--
  nuget.org is listed here so that CodeQL's buildless C# restore has an
  explicit feed to check: with no nuget.config in the repository it checks an
  empty set and logs "No NuGet feeds are reachable" (issue #150). There is no
  <clear />, so the GitHub source that csharp.yml adds to the user-level
  config stays visible to its push step.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
