{
  "metadata": [
    {
      "src": [
        {
          "files": ["Platform.Interfaces/Platform.Interfaces.csproj"]
        }
      ],
      "dest": "obj/api",
      "filter": "filter.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.yml"],
        "src": "obj/api",
        "dest": "api"
      },
      {
        "files": ["README.md"],
        "src": ".."
      },
      {
        "files": ["toc.yml"]
      }
    ],
    "globalMetadata": {
      "_appTitle": "LinksPlatform's Platform.Interfaces Library",
      "_enableSearch": true,
      "pdf": true,
      "pdfFileName": "Platform.Interfaces.Documentation.pdf",
      "pdfTocPage": true,
      "_gitContribute": {
        "branch": "main"
      },
      "_gitUrlPattern": "github"
    },
    "markdownEngineName": "markdig",
    "template": ["default", "modern"],
    "dest": "_site"
  }
}
